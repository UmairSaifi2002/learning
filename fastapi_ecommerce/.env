# ============================================
# APPLICATION CONFIGURATION
# ============================================

# The name that appears in API documentation
APP_NAME=E-Commerce API

# Current version of the API
APP_VERSION=1.0.0

# Debug mode: true for development, false for production
APP_DEBUG=true

# ============================================
# SERVER CONFIGURATION
# ============================================

# Host: 127.0.0.1 means localhost only
# Use 0.0.0.0 to allow connections from other devices
APP_HOST=127.0.0.1

# Port: 8000 is the FastAPI default
APP_PORT=8000

# ============================================
# CORS CONFIGURATION
# ============================================

# Allowed origins (comma-separated)
# * means all origins (development only!)
CORS_ORIGINS=*

# ============================================
# LOGGING CONFIGURATION
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG


# ============================================
# ENVIRONMENT CONFIGURATION
# ============================================

# Set to 'true' for development (your computer)
# Set to 'false' for production (live server)
IS_DEVELOPMENT=true

# ============================================
# DATABASE CONFIGURATION
# ============================================

DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ecommerce_db
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=umair
DATABASE_NAME=ecommerce_db

# ============================================
# APPLICATION CONFIGURATION
# ============================================

APP_NAME=E-Commerce API
APP_VERSION=1.0.0
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=*
LOG_LEVEL=DEBUG




